# Secrets and private/account-specific values only.
# General bot settings live in bot.config.json.

POLYGON_RPC_URL=https://polygon-rpc.com
POLYMARKET_FUNDER_ADDRESS=
POLYMARKET_PRIVATE_KEY=

# Optional. Leave blank to let the bot derive CLOB API credentials from the private key.
CLOB_API_KEY=
CLOB_SECRET=
CLOB_PASS_PHRASE=

# Optional. Required only when googleSheetsEnabled=true in bot.config.json.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
